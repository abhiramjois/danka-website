# Tina Cloud credentials — from https://app.tina.io
# 1. Create a project, connect the dankastudios/danka-website repo
# 2. Copy the Client ID and Read-only Token from the project's "Connect" screen
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Optional — only used by scripts/fetch-youtube.mjs, which refreshes
# src/lib/data/youtube.json before you build. The site itself serves the
# committed JSON, so no env vars are needed to run it.
YOUTUBE_CHANNEL_URL=
YTDLP_PATH=

# Where /collaborate enquiries are emailed. Read at build time by
# src/routes/api/contact/+server.ts via $env/static/private, then inlined into
# the Worker — so it is NOT read at runtime and changing it needs a rebuild.
#
# Set this as a build environment variable in Cloudflare
# (Settings → Builds → Environment variables), not just in .env, or the
# production build fails.
#
# Cloudflare only sends to addresses confirmed in Email Routing, so the
# recipient must be added under Email → Email Routing → Destination addresses.
CONTACT_EMAIL=
