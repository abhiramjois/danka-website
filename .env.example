# Real-time YouTube stats & thumbnails are fetched with yt-dlp (no API key needed).
# Install it once: brew install yt-dlp

# Optional overrides (defaults point to @DankaStudios)
# YOUTUBE_CHANNEL_URL=https://www.youtube.com/@DankaStudios
# YTDLP_PATH=yt-dlp
# YOUTUBE_CACHE_TTL_MS=60000

# Node adapter (production) — the port the built server listens on
# PORT=3000