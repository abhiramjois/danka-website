{
	"name": "danka-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.15.0"
	},
	"scripts": {
		"dev": "tinacms dev --watch \"vite dev\"",
		"dev:site": "vite dev",
		"build": "node scripts/build.mjs",
		"preview": "vite preview",
		"tina:dev": "tinacms dev",
		"tina:build": "tinacms build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fetch:youtube": "node scripts/fetch-youtube.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-netlify": "^5.2.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.5.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@tinacms/auth": "^1.1.5",
		"@tinacms/cli": "^3.0.0",
		"gray-matter": "^4.0.3",
		"marked": "^18.0.13",
		"tinacms": "^3.14.2"
	}
}
